package views

templ SlotMachineePage() {
	@DefaultLayout(slotMachineContent())
}

templ slotMachineContent() {
	<div class="slot-machine-container">
		<header class="game-header">
			<h1>🎰 Slot Machine Game</h1>
			<div class="credits-display">
				Credits: <span id="credits">0</span>
			</div>
		</header>
		<main class="game-area">
			<div class="slot-container">
				<div class="slot" id="slot-1">?</div>
				<div class="slot" id="slot-2">?</div>
				<div class="slot" id="slot-3">?</div>
			</div>
			<div class="controls">
				<button id="create-session-btn" class="btn btn-primary">Create Game Session</button>
				<button id="roll-btn" class="btn btn-secondary" style="display: none;">Roll (1 Credit)</button>
				<button id="cash-out-btn" class="btn btn-success" style="display: none;">Cash Out</button>
			</div>
			<div id="message" class="message"></div>
		</main>
		<footer class="game-info">
			<h3>How to Play:</h3>
			<ul>
				<li>🍒 Cherry = 10 credits</li>
				<li>🍋 Lemon = 20 credits</li>
				<li>🍊 Orange = 30 credits</li>
				<li>🍉 Watermelon = 40 credits</li>
			</ul>
			<p>Match all 3 symbols to win!</p>
		</footer>
	</div>
	<style>
		.slot-machine-container {
			max-width: 800px;
			margin: 0 auto;
			padding: 20px;
			font-family: 'Arial', sans-serif;
			text-align: center;
		}
		.game-header {
			margin-bottom: 30px;
		}
		.game-header h1 {
			color: #333;
			margin: 0 0 20px 0;
			font-size: 2.5rem;
		}
		.credits-display {
			font-size: 1.5rem;
			font-weight: bold;
			color: #2c5aa0;
			background: #f0f8ff;
			padding: 10px 20px;
			border-radius: 10px;
			display: inline-block;
		}
		.game-area {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			padding: 40px;
			border-radius: 20px;
			margin-bottom: 30px;
			box-shadow: 0 10px 30px rgba(0,0,0,0.3);
		}
		.slot-container {
			display: flex;
			justify-content: center;
			gap: 20px;
			margin-bottom: 30px;
		}
		.slot {
			width: 120px;
			height: 120px;
			background: white;
			border: 4px solid #333;
			border-radius: 15px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 4rem;
			font-weight: bold;
			box-shadow: inset 0 4px 8px rgba(0,0,0,0.1);
			transition: all 0.3s ease;
		}
		.slot.rolling {
			animation: roll 0.1s infinite;
			background: #ffeb3b;
		}
		@keyframes roll {
			0%, 100% { transform: scale(1); }
			50% { transform: scale(1.1); }
		}
		.controls {
			display: flex;
			justify-content: center;
			gap: 15px;
			flex-wrap: wrap;
		}
		.btn {
			padding: 12px 24px;
			border: none;
			border-radius: 8px;
			font-size: 1.1rem;
			font-weight: bold;
			cursor: pointer;
			transition: all 0.3s ease;
			min-width: 150px;
		}
		.btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 8px rgba(0,0,0,0.2);
		}
		.btn:disabled {
			opacity: 0.6;
			cursor: not-allowed;
			transform: none;
		}
		.btn-primary {
			background: #4CAF50;
			color: white;
		}
		.btn-primary:hover {
			background: #45a049;
		}
		.btn-secondary {
			background: #2196F3;
			color: white;
		}
		.btn-secondary:hover {
			background: #1976D2;
		}
		.btn-success {
			background: #FF9800;
			color: white;
		}
		.btn-success:hover {
			background: #F57C00;
		}
		.message {
			margin-top: 20px;
			padding: 10px 20px;
			border-radius: 8px;
			font-weight: bold;
			min-height: 20px;
		}
		.message.success {
			background: #d4edda;
			color: #155724;
			border: 1px solid #c3e6cb;
		}
		.message.error {
			background: #f8d7da;
			color: #721c24;
			border: 1px solid #f5c6cb;
		}
		.message.warning {
			background: #fff3cd;
			color: #856404;
			border: 1px solid #ffeaa7;
		}
		.message.win {
			background: #ffeb3b;
			color: #333;
			border: 1px solid #fdd835;
			font-size: 1.2rem;
			animation: celebration 0.5s ease-in-out;
		}
		@keyframes celebration {
			0%, 100% { transform: scale(1); }
			50% { transform: scale(1.05); }
		}
		.game-info {
			background: #f8f9fa;
			padding: 20px;
			border-radius: 10px;
			text-align: left;
			max-width: 400px;
			margin: 0 auto;
		}
		.game-info h3 {
			margin-top: 0;
			color: #333;
			text-align: center;
		}
		.game-info ul {
			list-style: none;
			padding: 0;
		}
		.game-info li {
			padding: 5px 0;
			font-size: 1.1rem;
		}
		.game-info p {
			text-align: center;
			font-weight: bold;
			color: #666;
			margin-bottom: 0;
		}
		@media (max-width: 600px) {
			.slot-container {
				gap: 10px;
			}
			.slot {
				width: 80px;
				height: 80px;
				font-size: 2.5rem;
			}
			.controls {
				flex-direction: column;
				align-items: center;
			}
			.btn {
				min-width: 200px;
			}
		}
	</style>
	<script src="/static/js/slot-machine.js"></script>
}