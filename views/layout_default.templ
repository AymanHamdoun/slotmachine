package views

templ DefaultLayout(content templ.Component) {
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/assets/vite.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/public/app.css"/>
        <title>Tailwind Templ</title>
      </head>
      <body>
        <header>
            navbar
        </header>
        @content
        <footer>
            footer
        </footer>
      </body>
    </html>
}
